const norm=s=>String(s).toLowerCase().replace(/[’‘]/g,"'").replace(/[^a-z0-9가-힣]/g,'');
const S={},ok=(v,al)=>{v=norm(v||'');return v!==''&&al.some(a=>norm(a)===v)};
const stt=(li,si)=>S[li+'-'+si]||(S[li+'-'+si]={mc:{},wr:{},self:{},g:false,arm:false});
function P(t){const o=[];let l=0;t.replace(/\[\[(.*?)\]\]/g,(m,a,i)=>{o.push({s:t.slice(l,i)});o.push({a:a.split('|')});l=i+m.length;return m});o.push({s:t.slice(l)});return o}
function route(){const m=location.hash.match(/^#(l\d)-([vlrg])$/);let li=0,si=0;if(m){li=Math.max(0,D.findIndex(l=>l.id===m[1]));si=Math.max(0,D[li].secs.findIndex(s=>s.id===m[2]))}return[li,si]}
function score(li,si){const sec=D[li].secs[si],s=stt(li,si);let n=0,t=sec.mc.length;sec.mc.forEach((q,i)=>{if(s.mc[i]===q.a)n++});let ei=0;
 sec.wr.forEach(e=>{if(e.t==null)return;let bi=0;P(e.t).forEach(p=>{if(p.a){t++;if(s.self[ei]||ok(s.wr[ei+':'+bi],p.a))n++;bi++}});ei++});return[n,t]}
function unans(li,si){const sec=D[li].secs[si],s=stt(li,si);let u=0;sec.mc.forEach((q,i)=>{if(s.mc[i]===undefined)u++});let ei=0;
 sec.wr.forEach(e=>{if(e.t==null)return;let bi=0;P(e.t).forEach(p=>{if(p.a){if(!(s.wr[ei+':'+bi]||'').trim())u++;bi++}});ei++});return u}
function render(){

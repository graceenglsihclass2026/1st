 let h=`<div class="hero"><div><p>${L.name} · ${L.sub}</p><h1>${sec.icon} ${sec.name}</h1><p>${sec.desc}</p></div><div class="score"><span>${s.g?n:'–'}</span> / ${t}<small>${s.g?'맞힌 문제':'채점 전'}</small><button class="btn" id="rs" style="margin-top:8px;background:#fff;color:#111;font-size:.85rem;padding:5px 12px">🔄 다시 풀기</button></div></div>`;
 h+=sec.note||'';
 if(sec.mc.length){h+=`<section><h2><i class="t">선택형</i> ${sec.mc.length}문항</h2><p class="desc">알맞은 것을 고르세요.</p>`+sec.mc.map((q,i)=>{const v=s.mc[i];return `<div class="q"><p>${i+1}. ${q.q}</p><div class="opts">`+q.o.map((o,oi)=>`<button data-q="${i}" data-o="${oi}" ${s.g?'disabled':''} class="${s.g?(v===oi?(oi===q.a?'ok':'no'):(oi===q.a?'key':'')):(v===oi?'sel':'')}">${o}</button>`).join('')+`</div></div>`}).join('')+`</section>`}
 const hw=t-sec.mc.length>0;h+=hw?`<section><h2><i class="t">서술형</i> 빈칸 ${t-sec.mc.length}개</h2><p class="desc">빈칸에 직접 쓰세요. 대소문자와 문장부호는 달라도 괜찮아요.</p>`:'';let ei=0;
 sec.wr.forEach(e=>{
  if(e.g){h+=`<h4 class="wg">${e.g}</h4>`;return}
  if(e.c!=null){h+=e.h?e.c:`<p class="ctx">${e.c}</p>`;return}
  let bi=0,bad=false,html='';
  P(e.t).forEach(p=>{if(p.s!==undefined){html+=p.s;return}const k=ei+':'+bi,v=s.wr[k]||'',good=s.self[ei]||ok(v,p.a);if(s.g&&!good)bad=true;
   html+=`<input class="in ${s.g?(good?'ok':'no'):''}" data-k="${k}" value="${esc(v)}" style="width:${Math.max(4,Math.min(34,p.a[0].length*.72+1))}em" ${s.g?'disabled':''} autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="빈칸">`;bi++});
  h+=`<div class="q"><p class="wl">${html}${e.p?e.p:''}</p>`;
  if(s.g&&bad){h+=`<div class="ans">정답: ${e.t.replace(/\[\[(.*?)\]\]/g,(m,a)=>{a=a.split('|');return '<b>'+a[0]+'</b>'+(a.length>1?'<small> (또는 '+a.slice(1).join(' / ')+')</small>':'')})}</div><label><input type="checkbox" data-self="${ei}" ${s.self[ei]?'checked':''}> 내 답도 맞아요 (자체 채점)</label>`}
  h+=`</div>`;ei++});
 h+=(hw?'</section>':'')+`<section><div class="q" style="text-align:center">`+(s.g?`<p style="font-size:1.2rem">📊 결과: <b>${n} / ${t}</b>${n===t?' 🎉 모두 맞혔어요!':''}</p><p class="desc">틀린 서술형은 정답과 내 답을 비교해 보고, 맞다고 생각하면 ‘내 답도 맞아요’를 체크하세요.</p><button class="btn" id="rs2">🔁 다시 풀기</button>`:`<p>다 풀었으면 채점해 보세요!</p><button class="btn" id="grd" style="font-size:1.05rem;padding:10px 22px">✅ 채점하기</button><p class="desc" id="gmsg"></p>`)+`</div></section>`;
 $('#page').innerHTML=h;
}
